---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { url } from '../utils/url';

const produkter = (await getCollection('produkter')).sort((a, b) => a.data.rekkefolge - b.data.rekkefolge);
---

<section id="produkter" class="bg-white py-20 lg:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>
        Produkter
      </p>
      <h2 class="mt-4 text-4xl sm:text-5xl" data-reveal style="--d: 80ms">
        Det vi lager
      </h2>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {produkter.map((p, i) => (
        <li data-reveal style={`--d: ${(i % 3) * 60}ms`}>
          <a href={url(`/${p.id}`)} class="card lift group flex h-full flex-col overflow-hidden bg-paper">
            <div class="aspect-[3/2] overflow-hidden">
              <Image
                src={p.data.bilde}
                alt=""
                width={600}
                class="size-full rounded-t-3xl object-cover transition-transform duration-300 ease-soft group-hover:scale-105"
                transition:name={`produkt-${p.id}`}
                transition:animate="initial"
                data-morph
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-2xl">{p.data.tittel}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{p.data.ingress}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600">
                Les mer
                <span
                  aria-hidden="true"
                  class="transition-transform duration-300 ease-soft group-hover:translate-x-1.5"
                >
                  →
                </span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
