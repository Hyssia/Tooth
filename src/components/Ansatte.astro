---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ansatte } from '../data/site';

const bilder = import.meta.glob<{ default: ImageMetadata }>('../assets/ansatte/*.jpg', { eager: true });
const bildeFor = (navn: string) => bilder[`../assets/ansatte/${navn}.jpg`].default;
---

<section id="ansatte" class="bg-white py-20 lg:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>
        Ansatte
      </p>
      <h2 class="mt-4 text-4xl sm:text-5xl" data-reveal style="--d: 80ms">
        Menneskene bak arbeidet
      </h2>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-6">
      {ansatte.map((person, i) => (
        <li class="group" data-reveal style={`--d: ${i * 70}ms`}>
          <div class="overflow-hidden rounded-3xl bg-paper transition-[transform,box-shadow] duration-500 ease-soft group-hover:-translate-y-1.5 group-hover:shadow-lift">
            <Image
              src={bildeFor(person.bilde)}
              alt={`Portrett av ${person.navn}`}
              width={600}
              height={750}
              fit="cover"
              position="top"
              class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-soft group-hover:scale-105"
            />
          </div>
          <p class="mt-4 font-display text-xl transition-colors duration-300 group-hover:text-brand-600">{person.navn}</p>
          {person.tittel && <p class="text-sm text-muted">{person.tittel}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
