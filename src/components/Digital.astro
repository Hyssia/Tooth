---
import { Image } from 'astro:assets';
import matron from '../assets/digital/ceramill-matron.jpg';
import fresemaskiner from '../assets/digital/fresemaskiner.jpg';
import printere from '../assets/digital/3d-printere.jpg';
import printModell from '../assets/digital/3d-print-modell.jpg';

const fakta = [
  { tall: '8', tekst: 'emner i automatisk emneskifter' },
  { tall: '24/7', tekst: 'produksjon uten oppsyn' },
  { tall: 'Våt + tørr', tekst: 'automatisk bytte mellom våt- og tørrfresing' },
  { tall: '3D-print', tekst: 'modeller printes i eget laboratorium' },
];

const bilder = [
  { src: matron, tekst: 'Ceramill Matron med emnemagasin' },
  { src: fresemaskiner, tekst: 'CORiTEC 350i Loader og Ceramill Matron' },
  { src: printere, tekst: '3D-printere fra Asiga' },
  { src: printModell, tekst: 'Nyprintet modell på byggeplaten' },
];
---

<section id="digital-produksjon" class="py-20 lg:py-28">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-[2rem] bg-brand-900 px-6 py-14 text-white sm:px-12 lg:px-16 lg:py-20"
      data-reveal="scale"
    >
      <div
        aria-hidden="true"
        class="float-slow absolute -right-24 -top-24 size-96 rounded-full bg-brand-500/30 blur-3xl"
      ></div>

      <div class="relative grid gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow !text-brand-300">Digital produksjon</p>
          <h2 class="mt-4 text-4xl sm:text-5xl">Ceramill Matron</h2>
          <p class="mt-6 leading-relaxed text-brand-100">
            Vår nyeste fresemaskin, Ceramill Matron fra Amann Girrbach, har en automatisk emneskifter med plass til åtte
            emner og bytter selv mellom våt- og tørrfresing. Maskinen kan dermed produsere døgnet rundt uten oppsyn –
            noe som er ekstra nyttig for tidkrevende arbeider som store broer.
          </p>
          <p class="mt-4 leading-relaxed text-brand-100">
            I tillegg freser vi på CORiTEC 350i Loader, som bearbeider alt fra CoCr og titan til zirkonia og plast, og
            vi printer modeller på egne 3D-printere fra Asiga.
          </p>
        </div>

        <dl class="grid grid-cols-2 gap-4 self-center">
          {fakta.map((f, i) => (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6" data-reveal style={`--d: ${100 + i * 60}ms`}>
              <dt class="font-display text-2xl text-white sm:text-3xl">{f.tall}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-brand-200">{f.tekst}</dd>
            </div>
          ))}
        </dl>
      </div>

      <ul class="relative mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {bilder.map((b, i) => (
          <li data-reveal style={`--d: ${i * 60}ms`}>
            <figure>
              <div class="overflow-hidden rounded-3xl">
                <Image src={b.src} alt={b.tekst} width={600} class="aspect-[4/5] w-full object-cover" />
              </div>
              <figcaption class="mt-3 text-sm leading-snug text-brand-200">{b.tekst}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
