---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base title="Fant ikke siden">
  <section class="container-page py-48 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-5xl">Fant ikke siden</h1>
    <p class="mt-4 text-muted">Siden finnes ikke, eller har blitt flyttet.</p>
    <a href={url('/')} class="btn btn-primary mt-8">
      Til forsiden
    </a>
  </section>
</Base>
