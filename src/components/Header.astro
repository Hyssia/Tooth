---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { meny, site } from '../data/site';
---

<header
  data-header
  class="group/header fixed inset-x-0 top-0 z-40 transition-[background-color,box-shadow,backdrop-filter] duration-500 data-[scrolled]:bg-paper/80 data-[scrolled]:shadow-soft data-[scrolled]:backdrop-blur-md"
>
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.navn} – til forsiden`}>
      <Image src={logo} alt={site.navn} width={253} height={96} loading="eager" class="h-12 w-auto" />
    </a>

    <nav aria-label="Hovedmeny" class="hidden items-center gap-8 lg:flex">
      {meny.map((punkt) => (
        <a
          href={punkt.href}
          class="relative text-[0.95rem] font-medium text-ink/80 transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-brand-600 after:transition-transform after:duration-500 hover:text-ink hover:after:scale-x-100"
        >
          {punkt.tekst}
        </a>
      ))}
      <a href={site.telefonLenke} class="btn btn-primary">
        {site.telefon}
      </a>
    </nav>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobilmeny"
      class="grid size-11 place-items-center rounded-full border border-line bg-white lg:hidden"
    >
      <span class="sr-only">Meny</span>
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 6h14M3 10h14M3 14h14"></path>
      </svg>
    </button>
  </div>

  <nav id="mobilmeny" data-menu aria-label="Mobilmeny" class="container-page hidden pb-4 data-[open]:block lg:!hidden">
    <div class="card flex flex-col p-2">
      {meny.map((punkt) => (
        <a href={punkt.href} class="rounded-2xl px-4 py-3 font-medium hover:bg-brand-50">
          {punkt.tekst}
        </a>
      ))}
      <a href={site.telefonLenke} class="btn btn-primary m-2">
        Ring {site.telefon}
      </a>
    </div>
  </nav>
</header>
